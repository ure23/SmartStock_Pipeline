# PostgreSQL connection settings (never commit the populated .env)
SMARTSTOCK_DB_HOST=127.0.0.1
SMARTSTOCK_DB_PORT=15432
SMARTSTOCK_DB_NAME=smartstock_pipeline
SMARTSTOCK_DB_USER=smartstock_pipeline
SMARTSTOCK_DB_PASSWORD=replace-with-a-secret
SMARTSTOCK_DB_CONNECT_TIMEOUT=5
# Compose-only administrator secret; do not pass it to pipeline workers.
POSTGRES_ADMIN_PASSWORD=replace-with-a-separate-random-secret
